:test the_default_is_used_when_the_flag_is_absent
:command compile
:blob executable 2
cc
:blob args 79
-std=c99 -Wall -Wextra -Werror -pedantic -I../.. enums.c -o .side_effects/enums
:int return 0
:command run
:blob executable 19
.side_effects/enums
:int return 0
:blob stdout 29
errors=0
log=verbose
force=0

