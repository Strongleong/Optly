:test values_are_collected_in_order
:command compile
:blob executable 2
cc
:blob args 91
-std=c99 -Wall -Wextra -Werror -pedantic -I../.. positionals.c -o .side_effects/positionals
:int return 0
:command run
:blob executable 25
.side_effects/positionals
:blob args 17
a.txt b.txt c.txt
:int return 0
:blob stdout 63
verbose=0
count=3
files[0]=a.txt
files[1]=b.txt
files[2]=c.txt

:test flags_may_be_interleaved_with_values
:command compile
:blob executable 2
cc
:blob args 91
-std=c99 -Wall -Wextra -Werror -pedantic -I../.. positionals.c -o .side_effects/positionals
:int return 0
