files[1]=b.txt

:test everything_after_a_double_dash_is_positional
:command compile
:blob executable 2
cc
:blob args 91
-std=c99 -Wall -Wextra -Werror -pedantic -I../.. positionals.c -o .side_effects/positionals
:int return 0
:command run
:blob executable 25
.side_effects/positionals
:blob args 27
-- --not-a-flag a.txt b.txt
:int return 0
:blob stdout 70
verbose=0
count=3
files[0]=--not-a-flag
files[1]=a.txt
files[2]=b.txt

:test a_double_dash_after_a_value_still_ends_flag_parsing
:command compile
:blob executable 2
cc
:blob args 91
-std=c99 -Wall -Wextra -Werror -pedantic -I../.. positionals.c -o .side_effects/positionals
