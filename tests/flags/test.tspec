:blob executable 2
cc
:blob args 79
-std=c99 -Wall -Wextra -Werror -pedantic -I../.. flags.c -o .side_effects/flags
:int return 0
:command run
:blob executable 19
.side_effects/flags
:blob args 4
-vqf
:int return 0
:blob stdout 46
verbose=1
quiet=1
force=1
threads=4
out=a.out

