:test defaults_are_used_when_no_flag_is_given
:command compile
:blob executable 2
cc
:blob args 79
-std=c99 -Wall -Wextra -Werror -pedantic -I../.. flags.c -o .side_effects/flags
:int return 0
:command run
:blob executable 19
.side_effects/flags
:int return 0
:blob stdout 46
verbose=0
quiet=0
force=0
threads=4
out=a.out

:test long_flags_are_recognised
:command compile
:blob executable 2
cc
:blob args 79
-std=c99 -Wall -Wextra -Werror -pedantic -I../.. flags.c -o .side_effects/flags
:int return 0
:command run
:blob executable 19
.side_effects/flags
:blob args 21
--verbose --threads 8
:int return 0
:blob stdout 46
verbose=1
quiet=0
force=0
threads=8
out=a.out

:test short_flags_are_recognised
